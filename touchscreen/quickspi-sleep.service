# The touch controller doesn't survive the quickspi driver's own suspend and
# resume: after a real s2idle sleep it stops answering commands, even though
# the resume reset reports success. A full driver reload does bring it back, so
# unload the driver before sleep and load it again on wake. udev restarts iptsd
# when the device reappears.
#
# modprobe -r, which also unloads intel_thc, is needed: reloading only
# intel_quickspi (rmmod) after a real sleep leaves the chip not answering
# ("Wait Get Report Response timeout"). Another Surface Pro 10 owner reported
# a kernel panic in xhci_bus_resume with intel_thc unloaded over sleep
# (linux-surface issue #2158), but it hasn't happened here.
[Unit]
Description=Reload the touchscreen driver across sleep
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/modprobe -r intel_quickspi
ExecStop=/usr/sbin/modprobe intel_quickspi

[Install]
WantedBy=sleep.target
